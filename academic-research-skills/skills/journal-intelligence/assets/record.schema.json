{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "顶刊识别、期刊画像与投稿匹配：任务记录",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "record_type": {
      "type": "string",
      "const": "journal-intelligence"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "observed",
        "assessed",
        "unverified",
        "not_applicable"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "fields": {
      "type": "object",
      "properties": {
        "journal_name": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "issn": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "mode": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "benchmark_rationale": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "metrics_with_year_category": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "representative_papers": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "fit_dimensions": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "hard_constraints": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "mismatches": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "policy_checks": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "verification_status": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        }
      },
      "required": [
        "journal_name",
        "issn",
        "mode",
        "scope",
        "benchmark_rationale",
        "metrics_with_year_category",
        "representative_papers",
        "fit_dimensions",
        "hard_constraints",
        "mismatches",
        "policy_checks",
        "verification_status"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "record_type",
    "status",
    "created_at",
    "source_refs",
    "artifact_refs",
    "fields"
  ],
  "additionalProperties": false
}
