{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional actual result occurrences and render dependencies v1",
  "oneOf": [{"$ref": "#/$defs/links"}, {"$ref": "#/$defs/render"}],
  "description": "Frozen output files own result values; mappings only select actual occurrences. Structural validity is not scientific, semantic or visual certification.",
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "description": "Project-relative bounded path; absolute paths, escapes and escaping symlinks are rejected."},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "locator": {
      "type": "object",
      "properties": {
        "line": {"type": "integer", "minimum": 1},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "paragraph": {"type": "integer", "minimum": 1},
        "table": {"type": "integer", "minimum": 1},
        "row": {"type": "integer", "minimum": 1},
        "cell": {"type": "integer", "minimum": 1},
        "page": {"type": "integer", "minimum": 1}
      },
      "anyOf": [{"required": ["line"]}, {"required": ["line_start"]}, {"required": ["paragraph"]}, {"required": ["table", "row", "cell"]}],
      "additionalProperties": false,
      "description": "1-based source line/range; DOCX XML paragraph (including empty and table paragraphs) or body table/row/cell; PDF requires page plus extracted line/range."
    },
    "source": {
      "allOf": [{"$ref": "#/$defs/artifact"}],
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "versions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/artifact"}}
      },
      "description": "Actual frozen CSV/JSON, keyed by stable result_id or result_id records. Numeric sources bind data/code/execution files in versions here or in their original record."
    },
    "semantic": {
      "type": "object",
      "required": ["value", "text"],
      "properties": {
        "value": {"type": ["string", "number"]},
        "text": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/locator"},
        "position": {"enum": ["prefix", "suffix"]}
      },
      "description": "Canonical source meaning plus text actually found. Free aliases must be defined in frozen source labels; unit and direction use conservative built-in conversions/aliases."
    },
    "numeric": {
      "type": "object",
      "required": ["field", "text"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "offset": {"type": "integer", "minimum": 0},
        "decimals": {"type": "integer", "minimum": 0, "maximum": 12},
        "rounding": {"enum": ["half-even", "half-up"], "default": "half-even"},
        "tolerance": {
          "type": "object",
          "properties": {"abs": {"type": "number", "minimum": 0}, "rel": {"type": "number", "minimum": 0}},
          "additionalProperties": false
        },
        "recomputed": {
          "type": "object",
          "required": ["source_id"],
          "properties": {"source_id": {"type": "string", "minLength": 1}, "result_id": {"type": "string", "minLength": 1}, "field": {"type": "string", "minLength": 1}}
        }
      },
      "dependentRequired": {"tolerance": ["recomputed"]},
      "description": "Read this exact numeric token at the locator. Decimal display rounding is independent of abs/rel tolerance against another hash-bound raw output."
    },
    "link": {
      "type": "object",
      "required": ["result_id", "role", "artifact", "locator"],
      "properties": {
        "result_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "claim_id": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/artifact"},
        "locator": {"$ref": "#/$defs/locator"},
        "numeric": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/numeric"}},
        "semantics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/semantic"}},
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {"text": {"type": "string", "minLength": 1}, "texts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
            "anyOf": [{"required": ["text"]}, {"required": ["texts"]}]
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "artifact", "locator", "text"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/artifact"},
        "locator": {"$ref": "#/$defs/locator"},
        "text": {"type": "string", "minLength": 1},
        "result_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "description": "Unlinked critical claims remain pending with their actual location and next action; no claim discovery completeness is asserted."
    },
    "links": {
      "type": "object",
      "required": ["kind", "sources", "links"],
      "properties": {
        "kind": {"const": "result-links"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "links": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/link"}},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
      }
    },
    "render": {
      "type": "object",
      "required": ["kind", "artifacts", "renders"],
      "properties": {
        "kind": {"const": "render-dependencies"},
        "artifacts": {
          "type": "array", "minItems": 1,
          "items": {"allOf": [{"$ref": "#/$defs/artifact"}], "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}}
        },
        "renders": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["output", "inputs", "renderer"],
            "properties": {
              "output": {"type": "string", "minLength": 1},
              "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "inputs": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
              "renderer": {"type": "object", "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
              "command": {"type": "array", "items": {"type": "string"}, "description": "Recorded provenance only; audit never executes this argv."}
            }
          }
        }
      },
      "description": "Current inventory hashes and prior render input/output snapshots may differ; stale ancestry is propagated and impacted targets reported in rebuild order."
    }
  }
}
