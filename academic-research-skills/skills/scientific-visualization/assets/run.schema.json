{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standalone academic research run",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3.0-alpha.1"
    },
    "skill": {
      "type": "string",
      "const": "scientific-visualization"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "completed",
        "blocked",
        "redesign",
        "stopped"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "access_notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "locator",
          "version",
          "access_notes"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "paper",
              "dataset",
              "standard",
              "policy",
              "software",
              "user_material",
              "observation",
              "other"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "access_level": {
            "type": "string"
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "unverified",
              "verified",
              "partial",
              "unavailable"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "locator",
          "title",
          "version",
          "checked_at",
          "access_level",
          "verification_status",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            },
            "uniqueItems": true
          },
          "generation_method": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "role",
          "sha256",
          "depends_on",
          "generation_method"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "produced",
              "blocked",
              "not_applicable"
            ]
          },
          "artifact_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "required",
          "status",
          "artifact_id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "unknown",
              "pass",
              "fail",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "status",
          "reason",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "resolved",
              "unavailable"
            ]
          },
          "blocks_current_scope": {
            "type": "boolean"
          },
          "required_action": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "description",
          "status",
          "blocks_current_scope",
          "required_action",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "skill",
    "run_id",
    "created_at",
    "updated_at",
    "request",
    "scope",
    "status",
    "inputs",
    "sources",
    "artifacts",
    "outputs",
    "gates",
    "unknowns",
    "external_dependencies",
    "next_actions"
  ],
  "additionalProperties": false
}
