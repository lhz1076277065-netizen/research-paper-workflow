  "professional_routes": {
    "research-intake": {
      "primary": "scholar-intake",
      "alternatives": [],
      "work": "Research Question Card, evidence needs, support/falsification criteria and minimal next action",
      "boundary": "Intake only; preserve latest user scope and existing fixed question.",
      "services": [
        "intake",
        "plan"
      ]
    },
    "topic-novelty": {
      "primary": "orchestra-ideation",
      "alternatives": [
        "scholar-intake"
      ],
      "work": "Apply suitable ideation lenses to the given problem; compare candidates and decisive tests",
      "boundary": "Open topics use brainstorming; fixed questions use scholar-intake evidence/gap subflow, without restarting open ideation.",
      "services": [
        "ideate",
        "novelty-check"
      ]
    },
    "literature-discovery": {
      "primary": "researchstudio-search",
      "alternatives": [],
      "work": "Bounded retrieval, screen real records and synthesize source-supported findings",
      "boundary": "No abstract or search snippet treated as full-text evidence.",
      "services": [
        "search"
      ]
    },
    "paper-deep-reading": {
      "primary": "nature-reader",
      "alternatives": [],
      "work": "Read the relevant original material, extract grounded findings and record exact locators",
      "boundary": "Partial material remains partial; no full-paper reading claim from an abstract.",
      "services": [
        "read",
        "extract",
        "translate"
      ]
    },
    "research-design": {
      "primary": "sleep-experiment-plan",
      "alternatives": [
        "kdense-design",
        "scholar-intake"
      ],
      "work": "Map claims to decisive checks, controls, dependencies, run order and stopping rules",
      "boundary": "Study design invokes kdense-design when assignment/randomization is the actual task; no native cross-model audit claimed.",
      "services": [
        "plan",
        "method-plan"
      ]
    },
    "data-discovery": {
      "primary": "kdense-database",
      "alternatives": [],
      "work": "Define retrieval contract, select authoritative source, verify filters and record access/provenance",
      "boundary": "Existing provided sources may be assessed without downloading; unknown rights remain unresolved.",
      "services": [
        "lookup",
        "acquire"
      ]
    },
    "data-preparation": {
      "primary": "kdense-eda",
      "alternatives": [],
      "work": "Profile actual format and units, diagnose missingness and apply justified transformations",
      "boundary": "Only real data and actual performed transformations.",
      "services": [
        "profile",
        "prepare"
      ]
    },
    "analysis-execution": {
      "primary": "kdense-statistics",
      "alternatives": [
        "scholar-analysis",
        "kdense-eda"
      ],
      "work": "Apply appropriate analysis to real inputs, compare baselines and bound interpretation",
      "boundary": "Statistical/descriptive tasks use KDense; ML analysis bundles use Scholar. Formal proof or interpretive tasks require a verified matching entry before proceeding.",
      "services": [
        "analyze",
        "method-plan"
      ]
    },
    "robustness-reproducibility": {
      "primary": "kdense-critical",
      "alternatives": [],
      "work": "Appraise units, bias, assumptions and replication; perform the requested rerun/check and bind findings",
      "boundary": "Appraisal alone cannot certify software rerun; retain executed commands/results when rerun requested.",
      "services": [
        "review",
        "experiment-review"
      ]
    },
    "scientific-visualization": {
      "primary": "scipilot-figure",
      "alternatives": [],
      "work": "Plan claim, choose chart, produce/edit and review numeric accuracy and final-size visual expression",
      "boundary": "Reference examples may supplement this main professional workflow, not replace it.",
      "services": [
        "plot",
        "figure-plan",
        "figure-review"
      ]
    },
    "manuscript-writing": {
      "primary": "kdense-writing",
      "alternatives": [],
      "work": "Evidence outline, draft within facts, reconcile methods/results and review affected content",
      "boundary": "Partial writing stays within requested section; no forced full study or human approval claim.",
      "services": [
        "draft",
        "revise"
      ]
    },
    "manuscript-review": {
      "primary": "academic-reviewer",
      "alternatives": [
        "kdense-critical"
      ],
      "work": "Review actual manuscript/evidence and return grounded issues with revision priorities",
      "boundary": "Current-host review is not independent cross-model peer review.",
      "profiles": {
        "focused": "kdense-critical",
        "full": "academic-reviewer"
      },
      "services": [
        "review"
      ]
    },
    "citation-audit": {
      "primary": "kdense-citation",
      "alternatives": [],
      "work": "Check actual identifiers/metadata, cited propositions and source locators; correct or flag gaps",
      "boundary": "Metadata success alone is not proposition verification.",
      "services": [
        "citation-check"
      ]
    },
    "journal-intelligence": {
      "primary": "kdense-venue",
      "alternatives": [],
      "work": "Resolve exact target and article type, consult official guidance, assess scope/audience and document fit limits",
      "boundary": "Ranking/matching must use actual journal scope sources; no invented acceptance likelihood.",
      "services": [
        "matching",
        "templates"
      ]
    },
    "ethics-protocol": {
      "primary": "kdense-writing",
