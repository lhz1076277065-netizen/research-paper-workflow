{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "内部评审、科学一致性与语言审校：任务记录",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "record_type": {
      "type": "string",
      "const": "manuscript-review"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "observed",
        "assessed",
        "unverified",
        "not_applicable"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "fields": {
      "type": "object",
      "properties": {
        "review_lens": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "issue": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "severity": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "required_change": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "changed_artifact": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "verification": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "residual_risk": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        }
      },
      "required": [
        "review_lens",
        "location",
        "issue",
        "severity",
        "evidence",
        "required_change",
        "changed_artifact",
        "verification",
        "residual_risk",
        "status"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "record_type",
    "status",
    "created_at",
    "source_refs",
    "artifact_refs",
    "fields"
  ],
  "additionalProperties": false
}
