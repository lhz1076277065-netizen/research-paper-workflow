    "runnable_python_check": "from pathlib import Path\nfrom decimal import Decimal as D\nimport csv, re\n\nbase = Path(\"LOCAL_EVIDENCE_ROOT/blind-manuscript\")\nrows = list(csv.DictReader((base/\"materials/fixed-results.csv\").read_text().splitlines()[1:]))\nexpected = [(r[\"condition\"],r[\"stratum\"],r[\"method\"],*(D(r[k]) for k in (\"n\",\"loss\",\"lo\",\"hi\"))) for r in rows]\npattern = re.compile(r\"^\\| (Reference|Changed) \\| (S[12]) \\| ([AB]) \\| (\\d+) \\| ([\\d.]+) \\| \\[([\\d.]+), ([\\d.]+)\\] \\|$\",re.M)\nfor group in (\"M1\",\"M2\",\"M3\"):\n    text = (base/group/\"manuscript.md\").read_text()\n    actual = [(m[0].lower(),m[1],m[2],*(D(x) for x in m[3:])) for m in pattern.findall(text)]\n    assert actual == expected, group\nweighted = {}\nfor condition in (\"reference\",\"changed\"):\n    weighted[condition] = {}\n    for method in (\"A\",\"B\"):\n        cells = [r for r in rows if r[\"condition\"]==condition and r[\"method\"]==method]\n        total = sum(D(r[\"n\"]) for r in cells)\n        assert total == 100\n        weighted[condition][method] = sum(D(r[\"n\"])*D(r[\"loss\"]) for r in cells)/total\nassert weighted == {\"reference\":{\"A\":D(\"4.80\"),\"B\":D(\"4.36\")},\"changed\":{\"A\":D(\"6.60\"),\"B\":D(\"7.52\")}}\nassert weighted[\"reference\"][\"B\"]-weighted[\"reference\"][\"A\"] == D(\"-0.44\")\nassert weighted[\"changed\"][\"B\"]-weighted[\"changed\"][\"A\"] == D(\"0.92\")\nfor c,s,v in ((\"reference\",\"S1\",\"-0.80\"),(\"reference\",\"S2\",\"1.00\"),(\"changed\",\"S1\",\"-0.20\"),(\"changed\",\"S2\",\"1.20\")):\n    losses = {r[\"method\"]:D(r[\"loss\"]) for r in rows if r[\"condition\"]==c and r[\"stratum\"]==s}\n    assert losses[\"B\"]-losses[\"A\"] == D(v)\nprint(\"PASS: 24 Markdown rows, 4 weighted averages, 2 weighted differences and 4 stratum differences\")\n"
  },
