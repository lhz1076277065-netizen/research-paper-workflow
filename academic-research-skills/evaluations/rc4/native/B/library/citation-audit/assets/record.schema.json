{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "引文真实性、语义支持与更新核查：任务记录",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "record_type": {
      "type": "string",
      "const": "citation-audit"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "observed",
        "assessed",
        "unverified",
        "not_applicable"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "fields": {
      "type": "object",
      "properties": {
        "citation_id": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "manuscript_claim": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "bibliography": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "source_read_level": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "support_locator": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "support_relation": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "version_and_publication_status": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "metadata_check": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "independence_of_evidence": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "required_correction": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        }
      },
      "required": [
        "citation_id",
        "manuscript_claim",
        "bibliography",
        "source_read_level",
        "support_locator",
        "support_relation",
        "version_and_publication_status",
        "metadata_check",
        "independence_of_evidence",
        "required_correction"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "record_type",
    "status",
    "created_at",
    "source_refs",
    "artifact_refs",
    "fields"
  ],
  "additionalProperties": false
}
