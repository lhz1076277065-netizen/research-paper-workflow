{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Host result envelope v1",
  "type": "object",
  "required": [
    "capability",
    "task_sha256",
    "provider_id",
    "execution_mode",
    "execution_status",
    "outputs"
  ],
  "properties": {
    "capability": {
      "type": "string"
    },
    "task_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_mode": {
      "enum": [
        "native",
        "script-adapter",
        "adapted-protocol",
        "host_fallback"
      ]
    },
    "execution_status": {
      "enum": [
        "executed",
        "partial",
        "failed",
        "blocked",
        "timeout"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "reviews": {
      "type": "array"
    },
    "evidence_checks": {
      "type": "array"
    },
    "result_links": {
      "oneOf": [
        {"$ref": "result-links.schema.json#/$defs/links"},
        {"$ref": "result-links.schema.json#/$defs/artifact"}
      ],
      "description": "Optional actual-occurrence audit, inline or a hash-bound project-relative JSON manifest."
    },
    "render_dependencies": {
      "oneOf": [
        {"$ref": "result-links.schema.json#/$defs/render"},
        {"$ref": "result-links.schema.json#/$defs/artifact"}
      ],
      "description": "Optional render DAG audit; reports stale rebuild targets without running render commands."
    }
  },
  "description": "Legacy result envelopes remain valid. accept-result checks actual identities, optional linkage audits and review bindings; a schema or hash cannot prove scientific truth or actual human/AI work."
}
