{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "完整学术论文撰写与修订：任务记录",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "record_type": {
      "type": "string",
      "const": "manuscript-writing"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "observed",
        "assessed",
        "unverified",
        "not_applicable"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "fields": {
      "type": "object",
      "properties": {
        "section": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "paragraph_or_anchor": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "purpose": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "claim_ids": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "result_ids": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "citation_ids": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "figure_table_ids": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "analysis_classification": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "word_budget": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "completion_status": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "unresolved_items": {
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        }
      },
      "required": [
        "section",
        "paragraph_or_anchor",
        "purpose",
        "claim_ids",
        "result_ids",
        "citation_ids",
        "figure_table_ids",
        "analysis_classification",
        "word_budget",
        "completion_status",
        "unresolved_items"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "record_type",
    "status",
    "created_at",
    "source_refs",
    "artifact_refs",
    "fields"
  ],
  "additionalProperties": false
}
